# Paythos secrets & runtime config — fill this in from VS Code as `.env`.
# `.env` is gitignored (AGENTS.md rule 5): keys NEVER leave this machine.
# This template IS committed; it contains only names and comments.

# ---- Required for `npm run e2e:arc` (Arc Testnet deployment) ----
# Burner wallet (owner) — fund with ≥1 USDC at https://faucet.circle.com (gas is USDC on Arc)
PAYTHOS_DEPLOYER_KEY=
# Any non-zero wallet you own (can be the deployer address itself)
PAYTHOS_TREASURY_ADDRESS=

# ---- Optional for e2e ----
# Agent signing key; freshly generated is fine, needs no funds
PAYTHOS_EPHEMERAL_KEY=
# Merchant payee (the x402 `payTo` you are purchasing from); required by e2e:mcp-live
PAYTHOS_MERCHANT_ADDRESS=
# Voucher amounts for the smoke run (decimal USD strings)
PAYTHOS_DEPOSIT_USD=0.50
PAYTHOS_CLAIM_USD=0.10
# Alternate RPC if the primary is unreachable
ARC_RPC_URL=https://rpc.testnet.arc.io

# ---- Optional, for `npm run mcp` / `npm run e2e:mcp-live` ----
# Existing v3 vault (from the e2e deploy or the current live build)
PAYTHOS_VAULT_ADDRESS=
# Where the ephemeral key should come from when running the MCP server
PAYTHOS_EPHEMERAL_KEY=
# Comma-separated merchant allowlist for the client-side GOFER gate
PAYTHOS_MERCHANTS=
